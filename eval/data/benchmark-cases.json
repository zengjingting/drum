{
  "experimentVersion": "easyinput-groove-eval.v1",
  "requestDefaults": {
    "schemaVersion": "easyinput.pattern-request.v1",
    "grid": {
      "beatsPerBar": 4,
      "stepsPerBeat": 4,
      "stepsPerBar": 16,
      "humanStepNumbering": "1-16",
      "beatSteps": [1, 5, 9, 13]
    },
    "tempo": {
      "minBpm": 40,
      "maxBpm": 240,
      "defaultBpm": 120
